<string name="settings_test_speed">Test speed</string>
<string name="test_speed_slow">Slow</string>
<string name="test_speed_medium">Medium</string>
<string name="test_speed_fast">Fast</string>
<string name="test_speed_slow_desc">Tests 4 servers at a time, takes 3 ping samples per server and runs one speed download at a time. Highest accuracy: stable ping, real jitter and a clean download speed. Scans take the longest, but it is the gentlest on battery and heat.</string>
<string name="test_speed_medium_desc">Tests 8 servers at a time, takes 2 ping samples per server and runs 2 speed downloads in parallel. Balanced speed and accuracy. Recommended for most people.</string>
<string name="test_speed_fast_desc">Tests 12 servers at a time, takes only 1 ping sample per server and runs 3 speed downloads in parallel. Much faster scans, but lower accuracy: jitter is not measured, a one-off glitch can hide a good server, and parallel downloads share your bandwidth so speeds read lower. Uses more battery and data.</string>
<string name="settings_advanced">Advanced</string>
<string name="settings_reduce_effects">Reduce visual effects</string>
<string name="settings_reduce_effects_desc">Turns off background blur and animation for smoother performance on older phones. Always on for low-memory devices.</string>
<string name="settings_allow_insecure">Allow invalid TLS certificates</string>
<string name="settings_allow_insecure_desc">Off by default. Turning it on lets servers with self-signed or mismatched certificates connect, but makes your traffic easier to intercept.</string>
